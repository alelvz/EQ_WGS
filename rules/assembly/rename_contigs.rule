rule rename_contigs:
    input:
        assembly = "assemblies/{sample}/final.contigs.fa",
        done = "assemblies/{sample}/{sample}.done"
    output:
        renamed = "assemblies/{sample}/{sample}_contigs.fa"
    log:
        "logs/rename_contigs/{sample}.log"
    shell:
        """
        sed 's/^>[^_]*_\\([^ ]*\\).*/>{wildcards.sample}_\\1/' {input.assembly} > {output.renamed} 2> {log}
        """
